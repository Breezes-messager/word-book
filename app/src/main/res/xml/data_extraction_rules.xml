<?xml version="1.0" encoding="utf-8"?>
<!-- 同上：只允许云备份/换机传输业务数据库，设置与 API Key 不参与 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
