# ---- 构建产物 ----
*.iml
.gradle/
/build
/captures
app/build/
*.apk
*.aab

# ---- 本机配置（含 SDK 路径，不入库）----
local.properties
/.idea/
.DS_Store
.externalNativeBuild
.cxx
*.keystore
!debug.keystore

# ---- 词库产物 ----
# words.db / dict.db 由 tools/build_assets.py 生成，
# 而且内容来自第三方词典（KyleBing/dict、ECDICT），
# 不入库既避免"公开分发词库"的版权风险，也避免仓库里躺 10MB 二进制。
# 克隆后先跑：python tools/build_assets.py
app/src/main/assets/*.db

# ---- 下载缓存 / 临时文件 ----
tools/.cache/
*.log
